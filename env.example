# Local: copy to server/.env.  Render: enter these in Dashboard -> Environment.
# NEVER commit real values.
TELEGRAM_BOT_TOKEN=            # NEW token from @BotFather after /revoke
WEBHOOK_SECRET=                # 16+ chars, letters/digits only (e.g. output of: openssl rand -hex 24)
PUBLIC_URL=https://YOUR-SERVER.onrender.com
SITE_ORIGIN=https://kino-quizz.web.app   # exact site URL, no trailing slash (CORS)
OWNER_EMAILS=egabehru0@gmail.com,dilshodabdurahimov12@gmail.com
FIREBASE_SERVICE_ACCOUNT=      # whole NEW service-account JSON on ONE line
# AI support bot (optional). Pick ONE provider:
AI_PROVIDER=anthropic          # anthropic or openai
ANTHROPIC_API_KEY=             # if AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=                # if AI_PROVIDER=openai
OPENAI_MODEL=                  # a current model name from OpenAI's docs
# Optional email sending (Gmail app password etc.)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
